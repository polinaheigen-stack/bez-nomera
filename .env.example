WEB_PORT=8027
# Copy this file to .env and set existing absolute directories on YOUR computer.
# Dataset directory contains images/, query/gallery bounding-box CSVs and optional ground truth.
VEHICLE_DATASET_DIR=./input
# Create this output directory before docker compose run. Each run uses a new subfolder.
VEHICLE_RESULTS_DIR=./results
# On Linux grant container UID 10001 write access to the results directory.
# The image verifies SOURCE_SHA256.json automatically; do not set a source digest manually.
